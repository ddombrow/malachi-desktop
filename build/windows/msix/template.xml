<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="malachi-desktop"
        Arguments=""
        InstallLocation="C:\Program Files\Daniel Dombrowsky\malachi">
    </Installer>
    <PackageInformation
        PackageName="malachi"
        PackageDisplayName="malachi"
        PublisherName="CN=Daniel Dombrowsky"
        PublisherDisplayName="Daniel Dombrowsky"
        Version="0.1.0.0"
        PackageDescription="A malachi-desktop application">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="io.github.ddombrow.malachidesktop"
                Description="A malachi-desktop application"
                DisplayName="malachi"
                ExecutableName="malachi-desktop"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>malachi</DisplayName>
            <PublisherDisplayName>Daniel Dombrowsky</PublisherDisplayName>
            <Description>A malachi-desktop application</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="malachi-desktop.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
